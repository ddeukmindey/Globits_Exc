<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>2.5.7</version>
		<relativePath></relativePath>
	</parent>

	<groupId>com.globits</groupId>
	<artifactId>sample-v3</artifactId>
	<version>1.0.0-SNAPSHOT</version>
	<packaging>pom</packaging>

	<name>sample-v3</name>
	<url>http://maven.apache.org</url>

	<distributionManagement>
		<snapshotRepository>
			<id>maven-snapshots</id>
			<url>http://www.globits.net:8081/repository/maven-snapshots/</url>
		</snapshotRepository>
	</distributionManagement>

	<repositories>
		<repository>
			<id>central</id>
			<url>https://repo.maven.apache.org/maven2/</url>
		</repository>
		<repository>
			<id>maven-snapshots</id>
			<url>http://www.globits.net:8081/repository/maven-snapshots/</url>
			<snapshots>
				<enabled>true</enabled>
				<updatePolicy>always</updatePolicy>
			</snapshots>
		</repository>
	</repositories>


	<modules>
		<module>sample-v3-api</module>
		<module>sample-v3-resource-server</module>
	</modules>
	<properties>
		<skipTests>true</skipTests>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<java-version>1.8</java-version>
		<maven.compiler.source>1.8</maven.compiler.source>
		<maven.compiler.target>1.8</maven.compiler.target>

		<commons-io.version>2.4</commons-io.version>
		<commons-lang3.version>3.4</commons-lang3.version>
		<apache-tika.version>1.9</apache-tika.version>

		<jodatime-hibernate.version>1.4</jodatime-hibernate.version>
		<hibernate.version>5.5.5.Final</hibernate.version>
		<user-type.joda-time.version>6.0.1.GA</user-type.joda-time.version>
		<joda-time.version>2.10</joda-time.version>
		<antisamy.version>1.5.3</antisamy.version>
		<imgscalr-lib.version>4.2</imgscalr-lib.version>

		<oauth.version>2.4.1.RELEASE</oauth.version>
		<jwt.version>1.0.10.RELEASE</jwt.version>
		<swagger.version>2.9.2</swagger.version>
        <oauth-autoconfig.version>2.4.10</oauth-autoconfig.version>
		<!-- util -->
		<commons-io.version>2.6</commons-io.version>
		<!-- Maven plugins -->
		<maven-compiler-plugin.version>3.8.0</maven-compiler-plugin.version>
		<maven-war-plugin.version>3.2.2</maven-war-plugin.version>
		<maven-surefire-plugin.version>2.22.1</maven-surefire-plugin.version>
        <cargo-maven2-plugin.version>1.7.3</cargo-maven2-plugin.version>
	</properties>
</project>